# Sao chép thành server/.env (hoặc .env ở thư mục gốc) rồi chỉnh.
# Không có GEMINI_API_KEY thì server chạy chế độ DEMO OFFLINE (câu trả lời soạn sẵn, miễn phí).

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Bật AI thật bằng gói miễn phí của Google AI Studio (https://aistudio.google.com/apikey).
# Lưu ý: gói miễn phí có thể dùng dữ liệu để cải thiện sản phẩm -> chỉ dùng cho demo, không nhập thông tin cá nhân.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Giới hạn tần suất (BR-11): tối đa RATE_MAX yêu cầu trong RATE_WINDOW_MS mili giây cho mỗi IP
RATE_WINDOW_MS=600000
RATE_MAX=60

# Giọng đọc (một giọng chung cho mọi nhân vật). Mặc định dùng Gemini TTS với cùng khoá ở trên.
# Giọng nam gợi ý: Orus, Alnilam, Gacrux, Charon, Fenrir, Algieba (chạy "npm run tts:samples -w server" để nghe thử).
TTS_PROVIDER=gemini
# Model có hiểu chỉ dẫn phong cách: gemini-3.1-flash-tts-preview. Model gemini-3.8-flash-lite-tts KHÔNG hiểu, nó sẽ đọc to cả lời chỉ dẫn (khi dùng nó thì để TTS_STYLE trống).
TTS_MODEL=gemini-3.1-flash-tts-preview
# Phong cách đọc (viết bằng tiếng Anh, không bị đọc ra): đổi để giọng hào hùng hơn hoặc nhẹ nhàng hơn
TTS_STYLE=Say in a deep, firm, heroic voice of an ancient Vietnamese general rallying his troops, with strong emphasis and a steady commanding pace
TTS_VOICE=Algieba
# Hoặc dùng Azure (giọng vi-VN-NamMinhNeural, trả về mp3): đặt TTS_PROVIDER=azure và điền hai dòng dưới
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
